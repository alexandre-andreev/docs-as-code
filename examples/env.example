# Скопируйте этот файл в .env и впишите свои ключи.
# Файл .env НЕ должен попадать в Git — добавьте его в .gitignore!

# Ключ Anthropic (для Claude Sonnet / Opus): https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ключ DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Ключ OpenAI (для GPT): https://platform.openai.com/
OPENAI_API_KEY=sk-proj-your-openai-key-here
